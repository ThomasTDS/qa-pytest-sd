# Copie este arquivo para .env (não versionado) e preencha com valores reais.

# URL da aplicação sob teste
BASE_URL=https://automationexercise.com/

# Rodar o navegador em modo headless (true/false). Padrão local: false.
HEADLESS=false

# Credenciais de uma conta já existente no automationexercise.com,
# usada pelos cenários de login. Crie a conta manualmente antes de rodar os testes.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
